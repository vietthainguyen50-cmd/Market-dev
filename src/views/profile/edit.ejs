<%- include('../partials/header') %>

<section class="section-space profile-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-xl-9">
        <div class="profile-edit-panel">
          <div class="page-heading mb-4">
            <div>
              <h1 class="h2 mb-2">Chỉnh sửa hồ sơ</h1>
              <p class="text-secondary mb-0">Cập nhật thông tin liên hệ và ảnh đại diện.</p>
            </div>
            <a class="btn btn-outline-secondary align-self-md-start" href="/profile">Quay lại hồ sơ</a>
          </div>

          <% if (errors.general) { %>
            <div class="alert alert-danger" role="alert"><%= errors.general %></div>
          <% } %>

          <% if (retryAvatar) { %>
            <div class="alert alert-warning" role="alert">
              File ảnh không được giữ lại sau khi request thất bại. Vui lòng chọn lại ảnh nếu bạn vẫn muốn tải lên.
            </div>
          <% } %>

          <form method="POST" action="/profile?_method=PUT" enctype="multipart/form-data">
            <div class="row g-4">
              <div class="col-12 col-lg-4">
                <div class="profile-avatar-panel p-4 text-center h-100">
                  <img
                    class="profile-avatar-preview mb-3"
                    src="<%= profileUser.avatarUrl %>"
                    alt="Ảnh đại diện hiện tại của <%= profileUser.name %>"
                    width="160"
                    height="160"
                  >
                  <label class="form-label fw-semibold" for="avatar">Ảnh đại diện mới</label>
                  <input
                    class="form-control <%= errors.avatar ? 'is-invalid' : '' %>"
                    id="avatar"
                    name="avatar"
                    type="file"
                    accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                    aria-invalid="<%= errors.avatar ? 'true' : 'false' %>"
                    aria-describedby="avatarError avatarHelp"
                  >
                  <div class="invalid-feedback field-feedback-slot" id="avatarError"><%= errors.avatar || '' %></div>
                  <p class="small text-secondary mt-2 mb-0" id="avatarHelp">Tối đa 2 MB. Chỉ JPG, JPEG, PNG hoặc WEBP.</p>

                  <% if (profileUser.hasManagedAvatar) { %>
                    <div class="form-check text-start mt-4 profile-remove-avatar">
                      <input class="form-check-input" id="removeAvatar" name="removeAvatar" type="checkbox" value="1">
                      <label class="form-check-label" for="removeAvatar">Xóa ảnh đại diện hiện tại</label>
                    </div>
                  <% } %>
                </div>
              </div>

              <div class="col-12 col-lg-8">
                <div class="mb-3">
                  <label class="form-label fw-semibold" for="name">Họ và tên</label>
                  <input
                    class="form-control <%= errors.name ? 'is-invalid' : '' %>"
                    id="name"
                    name="name"
                    type="text"
                    minlength="2"
                    maxlength="100"
                    autocomplete="name"
                    value="<%= oldInput.name %>"
                    aria-invalid="<%= errors.name ? 'true' : 'false' %>"
                    aria-describedby="profileNameError"
                    required
                  >
                  <div class="invalid-feedback field-feedback-slot" id="profileNameError"><%= errors.name || '' %></div>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold" for="profileEmail">Email</label>
                  <input class="form-control" id="profileEmail" type="email" value="<%= profileUser.email %>" disabled>
                  <div class="form-text">Email không thể thay đổi trong bước này.</div>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold" for="phone">Số điện thoại</label>
                  <input
                    class="form-control <%= errors.phone ? 'is-invalid' : '' %>"
                    id="phone"
                    name="phone"
                    type="tel"
                    maxlength="20"
                    autocomplete="tel"
                    value="<%= oldInput.phone %>"
                    aria-invalid="<%= errors.phone ? 'true' : 'false' %>"
                    aria-describedby="profilePhoneError"
                  >
                  <div class="invalid-feedback field-feedback-slot" id="profilePhoneError"><%= errors.phone || '' %></div>
                </div>

                <div class="mb-4">
                  <label class="form-label fw-semibold" for="address">Địa chỉ</label>
                  <textarea
                    class="form-control <%= errors.address ? 'is-invalid' : '' %>"
                    id="address"
                    name="address"
                    rows="4"
                    maxlength="200"
                    autocomplete="street-address"
                    aria-invalid="<%= errors.address ? 'true' : 'false' %>"
                    aria-describedby="profileAddressError"
                  ><%= oldInput.address %></textarea>
                  <div class="invalid-feedback field-feedback-slot" id="profileAddressError"><%= errors.address || '' %></div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                  <button class="btn btn-primary" type="submit">Lưu thay đổi</button>
                  <a class="btn btn-outline-secondary" href="/profile">Hủy</a>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
