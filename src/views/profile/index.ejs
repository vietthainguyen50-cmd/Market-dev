<%- include('../partials/header') %>

<section class="section-space profile-section">
  <div class="container">
    <% if (successMessage) { %>
      <div class="alert alert-success" role="status"><%= successMessage %></div>
    <% } %>

    <div class="profile-hero bg-white border mb-4">
      <div class="row align-items-center g-4">
        <div class="col-auto">
          <img
            class="profile-avatar"
            src="<%= profileUser.avatarUrl %>"
            alt="Ảnh đại diện của <%= profileUser.name %>"
            width="128"
            height="128"
          >
        </div>
        <div class="col-12 col-md">
          <h1 class="h2 mb-2"><%= profileUser.name %></h1>
          <p class="text-secondary mb-1"><%= profileUser.email %></p>
          <p class="small text-secondary mb-0">
            Tham gia từ ngày <%= profileUser.formattedCreatedAt %>
          </p>
        </div>
        <div class="col-12 col-lg-auto">
          <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" href="/profile/edit">Chỉnh sửa hồ sơ</a>
            <a class="btn btn-outline-primary" href="/listings/create">Đăng tin</a>
            <a class="btn btn-outline-dark" href="/my-listings">Bài đăng của tôi</a>
          </div>
        </div>
      </div>

      <dl class="row profile-details mt-4 mb-0">
        <dt class="col-sm-3 col-lg-2">Số điện thoại</dt>
        <dd class="col-sm-9 col-lg-4"><%= profileUser.phone || 'Chưa cập nhật' %></dd>
        <dt class="col-sm-3 col-lg-2">Địa chỉ</dt>
        <dd class="col-sm-9 col-lg-4"><%= profileUser.address || 'Chưa cập nhật' %></dd>
      </dl>
    </div>

    <div class="row g-3 mb-5" aria-label="Thống kê bài đăng">
      <div class="col-6 col-lg-3">
        <article class="profile-stat-card bg-white border h-100">
          <p class="small text-secondary mb-2">Tổng bài đăng</p>
          <p class="h2 fw-bold mb-0" data-stat="total"><%= stats.totalListings %></p>
        </article>
      </div>
      <div class="col-6 col-lg-3">
        <article class="profile-stat-card bg-white border h-100">
          <p class="small text-secondary mb-2">Đang bán</p>
          <p class="h2 fw-bold mb-0" data-stat="active"><%= stats.activeListings %></p>
        </article>
      </div>
      <div class="col-6 col-lg-3">
        <article class="profile-stat-card bg-white border h-100">
          <p class="small text-secondary mb-2">Đã bán</p>
          <p class="h2 fw-bold mb-0" data-stat="sold"><%= stats.soldListings %></p>
        </article>
      </div>
      <div class="col-6 col-lg-3">
        <article class="profile-stat-card bg-white border h-100">
          <p class="small text-secondary mb-2">Đã ẩn</p>
          <p class="h2 fw-bold mb-0" data-stat="hidden"><%= stats.hiddenListings %></p>
        </article>
      </div>
    </div>

    <div class="page-section-head mb-4">
      <div>
        <h2 class="h3 mb-2">Bài đăng mới nhất của bạn</h2>
        <p class="text-secondary mb-0">Theo dõi nhanh trạng thái các tin gần đây.</p>
      </div>
      <a class="btn btn-outline-secondary" href="/my-listings">Xem tất cả tin</a>
    </div>

    <% if (recentListings.length > 0) { %>
      <div class="row g-4">
        <% recentListings.forEach((listing) => { %>
          <div class="col-12 col-sm-6 col-xl-3" data-recent-listing="<%= listing._id %>">
            <%- include('../listings/_card', { listing }) %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="listing-empty-state" role="status">
        <h3 class="h4 fw-bold">Bạn chưa có bài đăng nào.</h3>
        <p class="text-secondary">Hãy đăng sản phẩm đầu tiên để bắt đầu kết nối với người mua.</p>
        <a class="btn btn-primary" href="/listings/create">Đăng tin đầu tiên</a>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
