<%- include('../partials/header') %>

<section class="section-space favorites-page" aria-labelledby="favorites-title">
  <div class="container">
    <div class="page-heading favorites-page-heading mb-4">
      <div>
        <h1 class="mb-2" id="favorites-title">Tin đã lưu</h1>
        <p class="text-secondary mb-0">
          Theo dõi những sản phẩm bạn quan tâm để dễ dàng quay lại.
        </p>
      </div>
      <a class="btn btn-outline-secondary" href="/listings">Khám phá sản phẩm</a>
    </div>

    <% if (Object.keys(errors).length > 0) { %>
      <div class="alert alert-danger" role="alert">
        <%= errors.page || errors.general || 'Yêu cầu không hợp lệ.' %>
      </div>
    <% } else { %>
      <div class="favorites-summary mb-4">
        <p class="fw-semibold mb-0" data-favorite-total="<%= totalItems %>">
          <%= totalItems %> sản phẩm đang hiển thị
        </p>
        <% if (pagination.totalPages > 1) { %>
          <p class="small text-secondary mb-0">
            Trang <%= currentPage %> / <%= pagination.totalPages %>
          </p>
        <% } %>
      </div>

      <% if (listings.length > 0) { %>
        <div class="row g-4">
          <% listings.forEach((listing) => { %>
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
              <%- include('../listings/_card', {
                listing,
                showFavoriteAction: true,
                favoriteReturnTo: currentUrl
              }) %>
            </div>
          <% }); %>
        </div>

        <%- include('../listings/_pagination', { pagination }) %>
      <% } else { %>
        <div class="favorite-empty-state" role="status">
          <div class="favorite-empty-icon" aria-hidden="true">
            <svg class="favorite-icon" viewBox="0 0 24 24">
              <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"></path>
            </svg>
          </div>
          <h2 class="h4 mb-2">Bạn chưa lưu sản phẩm nào.</h2>
          <p class="text-secondary">
            Nhấn biểu tượng trái tim trên sản phẩm để thêm vào danh sách này.
          </p>
          <a class="btn btn-primary" href="/listings">Khám phá sản phẩm</a>
        </div>
      <% } %>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
