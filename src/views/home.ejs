<%- include('partials/header') %>

<section class="hero-section market-hero">
  <div class="container">
    <div class="market-hero-layout">
      <div class="market-hero-copy">
        <p class="market-hero-intro">Mua bán đồ cũ trong cộng đồng</p>
        <h1>Trao đồ cũ. Tìm đúng người cần.</h1>
        <p class="market-hero-lede">
          Khám phá món đồ phù hợp, lọc theo nhu cầu và đăng tin ngay trên
          NTT Marketplace.
        </p>
        <form class="hero-search" method="GET" action="/listings" role="search">
          <label class="visually-hidden" for="homeKeyword">Từ khóa sản phẩm</label>
          <div class="input-group">
            <input
              class="form-control"
              id="homeKeyword"
              name="keyword"
              type="search"
              maxlength="100"
              placeholder="Tên hoặc mô tả sản phẩm"
            >
            <button class="btn btn-primary" type="submit">Tìm sản phẩm</button>
          </div>
        </form>
        <div class="market-hero-actions">
          <a class="btn btn-outline-primary" href="/listings">Xem tất cả tin</a>
          <a class="btn btn-outline-secondary" href="<%= isAuthenticated ? '/listings/create' : '/login' %>">
            Đăng tin
          </a>
        </div>
      </div>

      <aside class="market-hero-index" aria-label="Khám phá nhanh">
        <p class="market-hero-index-title">Khám phá nhanh</p>
        <a class="market-hero-index-link" href="#categories">
          <span>Danh mục đang hiển thị</span>
          <span class="market-hero-index-value"><%= categories.length %></span>
        </a>
        <a class="market-hero-index-link" href="#products">
          <span>Tin mới đang hiển thị</span>
          <span class="market-hero-index-value"><%= listings.length %></span>
        </a>
        <a class="market-hero-index-link" href="/listings">
          <span>Mở danh sách sản phẩm</span>
          <span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </div>
</section>

<section class="section-space bg-white" id="categories">
  <div class="container">
    <div class="page-section-head">
      <div>
        <h2 class="mb-2">Khám phá theo danh mục</h2>
        <p class="text-secondary mb-0">Đi thẳng đến nhóm sản phẩm bạn quan tâm.</p>
      </div>
      <a class="btn btn-outline-secondary" href="/categories">Tất cả danh mục</a>
    </div>
    <% if (categories.length > 0) { %>
      <div class="row g-4 mt-3">
        <% categories.forEach((category) => { %>
          <div class="col-12 col-sm-6 col-lg-3">
            <a class="category-card-link" href="/categories/<%= category.slug %>">
              <article class="category-card h-100">
                <div class="category-media mb-3">
                  <% if (category.image) { %>
                    <img
                      class="category-image"
                      src="<%= category.image %>"
                      alt="Ảnh danh mục <%= category.name %>"
                      width="800"
                      height="450"
                    >
                  <% } else { %>
                    <div class="category-card__icon" aria-hidden="true">
                      <%- include('categories/_icon', { category }) %>
                    </div>
                  <% } %>
                </div>
                <h3 class="h5 fw-bold mb-1"><%= category.name %></h3>
                <p class="small text-secondary mb-0">
                  <%= category.description || 'Khám phá sản phẩm trong danh mục này.' %>
                </p>
              </article>
            </a>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state mt-4" role="status">
        <h3 class="h5">Chưa có danh mục hoạt động.</h3>
        <p class="text-secondary mb-0">Danh mục sẽ xuất hiện tại đây khi được quản trị viên kích hoạt.</p>
      </div>
    <% } %>
  </div>
</section>

<section class="section-space products-section" id="products">
  <div class="container">
    <div class="page-section-head">
      <div>
        <h2 class="mb-2">Tin mới đăng</h2>
        <p class="text-secondary mb-0">Các sản phẩm đang được cộng đồng rao bán gần đây.</p>
      </div>
      <a class="btn btn-outline-secondary" href="/listings">Xem tất cả tin</a>
    </div>
    <% if (listings.length > 0) { %>
      <div class="row g-4 mt-3">
        <% listings.forEach((listing) => { %>
          <div class="col-12 col-sm-6 col-xl-3">
            <%- include('listings/_card', {
              listing,
              showFavoriteAction: true,
              favoriteReturnTo: currentUrl
            }) %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state mt-4" role="status">
        <h3 class="h5">Chưa có sản phẩm đang bán.</h3>
        <p class="text-secondary">Đăng tin đầu tiên để bắt đầu kết nối với người mua.</p>
        <a class="btn btn-primary" href="<%= isAuthenticated ? '/listings/create' : '/login' %>">Đăng tin</a>
      </div>
    <% } %>
  </div>
</section>

<section class="container pb-5" id="post-ad">
  <div class="post-ad-banner p-4 p-lg-5 d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-4">
    <div>
      <h2 class="h3 mb-2">Bạn có món đồ không còn dùng?</h2>
      <p class="mb-0">Tạo bài đăng rõ ràng để kết nối với người đang cần nó.</p>
    </div>
    <a class="btn btn-light" href="<%= isAuthenticated ? '/listings/create' : '/login' %>">
      Tạo bài đăng
    </a>
  </div>
</section>

<%- include('partials/footer') %>
