<%- include('partials/header') %>

<% const featuredListing = listings.length > 0 ? listings[0] : null; %>

<section class="hero-section market-hero">
  <div class="container">
    <div class="market-hero-layout">
      <div class="market-hero-copy">
        <p class="market-hero-intro">Mua bán đồ cũ trong cộng đồng</p>
        <h1>Trao đồ cũ. Tìm đúng người cần.</h1>
        <p class="market-hero-lede">
          Khám phá món đồ phù hợp, lọc theo nhu cầu và đăng tin ngay trên
          NTT Marketplace.
        </p>
        <form class="hero-search" method="GET" action="/listings" role="search">
          <label class="visually-hidden" for="homeKeyword">Từ khóa sản phẩm</label>
          <div class="input-group">
            <input
              class="form-control"
              id="homeKeyword"
              name="keyword"
              type="search"
              maxlength="100"
              placeholder="Tên hoặc mô tả sản phẩm"
            >
            <button class="btn btn-primary" type="submit">Tìm sản phẩm</button>
          </div>
        </form>
        <div class="market-hero-actions">
          <a class="btn btn-outline-primary" href="/listings">Xem tất cả tin</a>
          <a class="btn btn-outline-secondary" href="<%= isAuthenticated ? '/listings/create' : '/login' %>">
            Đăng tin
          </a>
        </div>
      </div>

      <% if (featuredListing) { %>
        <article class="market-hero-featured">
          <a
            class="market-hero-featured__media"
            href="/listings/<%= featuredListing._id %>"
            aria-label="Xem <%= featuredListing.title %>"
          >
            <img
              src="<%= featuredListing.primaryImage %>"
              alt="Ảnh sản phẩm <%= featuredListing.title %>"
              width="800"
              height="600"
              fetchpriority="high"
            >
          </a>
          <div class="market-hero-featured__body">
            <div class="market-hero-featured__meta">
              <span class="condition-badge"><%= featuredListing.conditionLabel %></span>
              <span>Tin mới</span>
            </div>
            <h2>
              <a href="/listings/<%= featuredListing._id %>"><%= featuredListing.title %></a>
            </h2>
            <p class="market-hero-featured__price"><%= featuredListing.formattedPrice %></p>
            <p class="market-hero-featured__location">
              <%= featuredListing.location %>
              <% if (featuredListing.category) { %>
                · <%= featuredListing.category.name %>
              <% } %>
            </p>
          </div>
        </article>
      <% } else { %>
        <aside class="market-hero-featured market-hero-featured--empty" aria-label="Trạng thái sản phẩm mới">
          <svg
            class="market-hero-empty-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 7h16v13H4z"></path>
            <path d="M8 7a4 4 0 0 1 8 0"></path>
            <path d="M9 12h6"></path>
          </svg>
          <div>
            <h2>Tin mới sẽ xuất hiện tại đây.</h2>
            <p>Đăng sản phẩm đầu tiên để cộng đồng có thể tìm thấy món đồ của bạn.</p>
          </div>
        </aside>
      <% } %>
    </div>
  </div>
</section>

<section class="home-section home-products-section" id="products">
  <div class="container">
    <div class="home-section-heading">
      <div>
        <h2>Sản phẩm mới đăng</h2>
        <p>Những món đồ vừa được cộng đồng đưa lên Marketplace.</p>
      </div>
      <a class="home-section-link" href="/listings">Xem tất cả →</a>
    </div>
    <% if (listings.length > 0) { %>
      <div class="row g-3 g-xl-4 home-products-grid">
        <% listings.forEach((listing) => { %>
          <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <%- include('listings/_card', {
              listing,
              showFavoriteAction: true,
              favoriteReturnTo: currentUrl
            }) %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state" role="status">
        <h3 class="h5">Chưa có sản phẩm đang bán.</h3>
        <p class="text-secondary">Đăng tin đầu tiên để bắt đầu kết nối với người mua.</p>
        <a class="btn btn-primary" href="<%= isAuthenticated ? '/listings/create' : '/login' %>">Đăng tin</a>
      </div>
    <% } %>
  </div>
</section>

<section class="home-section home-categories-section" id="categories">
  <div class="container">
    <div class="home-section-heading">
      <div>
        <h2>Khám phá theo danh mục</h2>
        <p>Đi thẳng đến nhóm sản phẩm bạn đang quan tâm.</p>
      </div>
      <a class="home-section-link" href="/categories">Tất cả danh mục →</a>
    </div>
    <% if (categories.length > 0) { %>
      <div class="home-category-grid">
        <% categories.forEach((category) => { %>
          <a class="home-category-link" href="/categories/<%= category.slug %>">
            <article class="home-category-card">
              <span class="home-category-icon" aria-hidden="true">
                <%- include('categories/_icon', { category }) %>
              </span>
              <h3><%= category.name %></h3>
            </article>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state" role="status">
        <h3 class="h5">Chưa có danh mục hoạt động.</h3>
        <p class="text-secondary mb-0">Danh mục sẽ xuất hiện tại đây khi được quản trị viên kích hoạt.</p>
      </div>
    <% } %>
  </div>
</section>

<section class="home-section home-benefits-section" aria-labelledby="homeBenefitsTitle">
  <div class="container">
    <div class="home-benefits-heading">
      <h2 id="homeBenefitsTitle">Mua bán theo cách đơn giản.</h2>
      <p>Mỗi công cụ chính đều nằm ngay trong luồng sử dụng hiện tại.</p>
    </div>
    <div class="home-benefit-list">
      <article class="home-benefit">
        <span class="home-benefit-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
          </svg>
        </span>
        <div>
          <h3>Đăng tin nhanh chóng</h3>
          <p>Thêm thông tin và ảnh để đưa món đồ của bạn lên Marketplace.</p>
        </div>
      </article>
      <article class="home-benefit">
        <span class="home-benefit-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"></path>
            <path d="M8 9h8M8 13h5"></path>
          </svg>
        </span>
        <div>
          <h3>Trao đổi trực tiếp</h3>
          <p>Nhắn tin với người mua hoặc người bán theo đúng từng bài đăng.</p>
        </div>
      </article>
      <article class="home-benefit">
        <span class="home-benefit-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-4-4"></path>
            <path d="M8 11h6"></path>
          </svg>
        </span>
        <div>
          <h3>Tìm kiếm dễ dàng</h3>
          <p>Tìm theo từ khóa và danh mục để thu hẹp sản phẩm phù hợp.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="home-cta-section" id="post-ad">
  <div class="container">
    <div class="home-cta-panel">
      <div>
        <h2>Bạn có món đồ không còn sử dụng?</h2>
        <p>Tạo một bài đăng rõ ràng để kết nối với người đang cần món đồ đó.</p>
      </div>
      <a class="btn btn-light" href="<%= isAuthenticated ? '/listings/create' : '/login' %>">
        Đăng tin ngay
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
