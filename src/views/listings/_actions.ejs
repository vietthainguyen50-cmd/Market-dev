<div class="listing-actions">
  <% if (listing.isHiddenByAdmin) { %>
    <p class="alert alert-warning mb-0" role="status">
      Bài đăng đang bị quản trị viên ẩn và không thể chỉnh sửa.
    </p>
  <% } else { %>
  <a class="btn btn-outline-primary" href="/listings/<%= listing._id %>/edit">
    Chỉnh sửa
  </a>

  <% if (listing.status === 'active') { %>
    <form method="POST" action="/listings/<%= listing._id %>/status?_method=PATCH">
      <input type="hidden" name="status" value="sold">
      <button class="btn btn-outline-success" type="submit">Đánh dấu đã bán</button>
    </form>
  <% } else { %>
    <form method="POST" action="/listings/<%= listing._id %>/status?_method=PATCH">
      <input type="hidden" name="status" value="active">
      <button class="btn btn-outline-success" type="submit">Đăng bán lại</button>
    </form>
  <% } %>

  <% if (listing.status !== 'hidden') { %>
    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
      <button class="btn btn-outline-danger" type="submit">Ẩn bài đăng</button>
    </form>
  <% } %>
  <% } %>
</div>
