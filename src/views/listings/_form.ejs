<form class="listing-form" action="<%= formAction %>" method="POST" enctype="multipart/form-data">
  <%- include('../partials/csrf') %>
  <section class="form-section" aria-labelledby="listing-basic-title">
    <div>
      <h2 class="form-section-title" id="listing-basic-title">Thông tin cơ bản</h2>
      <p class="small text-secondary mb-0">Đặt tiêu đề rõ ràng và mô tả đúng tình trạng sản phẩm.</p>
    </div>

  <div class="mb-3">
    <label class="form-label fw-semibold" for="title">Tiêu đề</label>
    <input
      class="form-control<%= errors.title ? ' is-invalid' : '' %>"
      id="title"
      name="title"
      type="text"
      value="<%= oldInput.title %>"
      minlength="5"
      maxlength="150"
      aria-invalid="<%= errors.title ? 'true' : 'false' %>"
      aria-describedby="titleError"
      required
    >
    <div class="invalid-feedback field-feedback-slot" id="titleError"><%= errors.title || '' %></div>
  </div>

  <div class="mb-3">
    <label class="form-label fw-semibold" for="description">Mô tả</label>
    <textarea
      class="form-control<%= errors.description ? ' is-invalid' : '' %>"
      id="description"
      name="description"
      rows="7"
      minlength="20"
      maxlength="3000"
      aria-invalid="<%= errors.description ? 'true' : 'false' %>"
      aria-describedby="descriptionError"
      required
    ><%= oldInput.description %></textarea>
    <div class="invalid-feedback field-feedback-slot" id="descriptionError"><%= errors.description || '' %></div>
  </div>
  </section>

  <section class="form-section" aria-labelledby="listing-details-title">
    <div>
      <h2 class="form-section-title" id="listing-details-title">Giá và thông tin phân loại</h2>
      <p class="small text-secondary mb-0">Giúp người mua lọc sản phẩm theo nhu cầu.</p>
    </div>

  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label fw-semibold" for="price">Giá bán (VND)</label>
      <input
        class="form-control<%= errors.price ? ' is-invalid' : '' %>"
        id="price"
        name="price"
        type="number"
        value="<%= oldInput.price %>"
        min="0"
        max="100000000000"
        step="1"
        aria-invalid="<%= errors.price ? 'true' : 'false' %>"
        aria-describedby="priceError"
        required
      >
      <div class="invalid-feedback field-feedback-slot" id="priceError"><%= errors.price || '' %></div>
    </div>

    <div class="col-md-6">
      <label class="form-label fw-semibold" for="category">Danh mục</label>
      <select
        class="form-select<%= errors.category ? ' is-invalid' : '' %>"
        id="category"
        name="category"
        aria-invalid="<%= errors.category ? 'true' : 'false' %>"
        aria-describedby="categoryError"
        required
      >
        <option value="">Chọn danh mục</option>
        <% categories.forEach((category) => { %>
          <option
            value="<%= category._id %>"
            <%= oldInput.category === category._id.toString() ? 'selected' : '' %>
            <%= category.status !== 'active' ? 'disabled' : '' %>
          >
            <%= category.name %><%= category.status !== 'active' ? ' (Không hoạt động)' : '' %>
          </option>
        <% }); %>
      </select>
      <div class="invalid-feedback field-feedback-slot" id="categoryError"><%= errors.category || '' %></div>
    </div>

    <div class="col-md-6">
      <label class="form-label fw-semibold" for="location">Địa điểm</label>
      <input
        class="form-control<%= errors.location ? ' is-invalid' : '' %>"
        id="location"
        name="location"
        type="text"
        value="<%= oldInput.location %>"
        minlength="2"
        maxlength="150"
        aria-invalid="<%= errors.location ? 'true' : 'false' %>"
        aria-describedby="locationError"
        required
      >
      <div class="invalid-feedback field-feedback-slot" id="locationError"><%= errors.location || '' %></div>
    </div>

    <div class="col-md-6">
      <label class="form-label fw-semibold" for="condition">Tình trạng</label>
      <select
        class="form-select<%= errors.condition ? ' is-invalid' : '' %>"
        id="condition"
        name="condition"
        aria-invalid="<%= errors.condition ? 'true' : 'false' %>"
        aria-describedby="conditionError"
        required
      >
        <option value="used"<%= oldInput.condition === 'used' ? ' selected' : '' %>>Đã sử dụng</option>
        <option value="new"<%= oldInput.condition === 'new' ? ' selected' : '' %>>Mới</option>
      </select>
      <div class="invalid-feedback field-feedback-slot" id="conditionError"><%= errors.condition || '' %></div>
    </div>
  </div>
  </section>

  <section class="form-section" aria-labelledby="listing-images-title">
    <div>
      <h2 class="form-section-title" id="listing-images-title">Ảnh sản phẩm</h2>
      <p class="small text-secondary mb-0">Ảnh đầu tiên sẽ được dùng làm ảnh chính.</p>
    </div>
  <% if (existingImages.length > 0) { %>
    <fieldset class="mt-4">
      <legend class="h5 fw-bold mb-2">Ảnh hiện tại</legend>
      <p class="text-secondary small">
        Bài đăng đang có <%= existingImages.length %> ảnh,
        còn <%= remainingImageSlots %> vị trí trong giới hạn <%= maxImages %> ảnh.
      </p>
      <div class="row g-3">
        <% existingImages.forEach((imagePath, index) => { %>
          <div class="col-6 col-md-4">
            <label class="listing-image-remove-card">
              <img
                class="listing-edit-thumbnail"
                src="<%= imagePath %>"
                alt="Ảnh <%= index + 1 %> của <%= listing.title %>"
                width="800"
                height="600"
                loading="lazy"
              >
              <span class="form-check mt-2">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="removeImages"
                  value="<%= imagePath %>"
                  <%= selectedRemoveImages.includes(imagePath) ? 'checked' : '' %>
                >
                <span class="form-check-label">Xóa ảnh này</span>
              </span>
            </label>
          </div>
        <% }); %>
      </div>
    </fieldset>
  <% } %>

  <div class="mt-4">
    <label class="form-label fw-semibold" for="images">
      <%= existingImages.length > 0 ? 'Thêm ảnh mới' : 'Ảnh sản phẩm' %>
    </label>
    <input
      class="form-control<%= errors.images ? ' is-invalid' : '' %>"
      id="images"
      name="images"
      type="file"
      accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
      multiple
      aria-invalid="<%= errors.images ? 'true' : 'false' %>"
      aria-describedby="imagesError imagesHelp"
    >
    <div class="invalid-feedback field-feedback-slot" id="imagesError"><%= errors.images || '' %></div>
    <div class="form-text" id="imagesHelp">
      Ảnh không bắt buộc. Tối đa <%= maxImages %> ảnh cho mỗi bài đăng,
      mỗi ảnh tối đa 5 MB. Chấp nhận JPG, JPEG, PNG và WEBP.
    </div>
  </div>

  <% if (retryImages) { %>
    <div class="alert alert-warning mt-3 mb-0" role="alert">
      Các file vừa chọn không được giữ lại. Vui lòng chọn lại ảnh trước khi gửi form.
    </div>
  <% } %>
  </section>

  <div class="form-actions">
    <button class="btn btn-primary px-4" type="submit" <%= canSubmit ? '' : 'disabled' %>>
      <%= submitLabel %>
    </button>
    <a class="btn btn-outline-secondary px-4" href="<%= cancelUrl %>">Hủy</a>
  </div>
</form>
