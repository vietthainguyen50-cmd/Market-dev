<form action="<%= formAction %>" method="POST" enctype="multipart/form-data">
  <div class="mb-3">
    <label class="form-label fw-semibold" for="title">Tiêu đề</label>
    <input
      class="form-control<%= errors.title ? ' is-invalid' : '' %>"
      id="title"
      name="title"
      type="text"
      value="<%= oldInput.title %>"
      minlength="5"
      maxlength="150"
      required
    >
    <% if (errors.title) { %>
      <div class="invalid-feedback"><%= errors.title %></div>
    <% } %>
  </div>

  <div class="mb-3">
    <label class="form-label fw-semibold" for="description">Mô tả</label>
    <textarea
      class="form-control<%= errors.description ? ' is-invalid' : '' %>"
      id="description"
      name="description"
      rows="7"
      minlength="20"
      maxlength="3000"
      required
    ><%= oldInput.description %></textarea>
    <% if (errors.description) { %>
      <div class="invalid-feedback"><%= errors.description %></div>
    <% } %>
  </div>

  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label fw-semibold" for="price">Giá bán (VND)</label>
      <input
        class="form-control<%= errors.price ? ' is-invalid' : '' %>"
        id="price"
        name="price"
        type="number"
        value="<%= oldInput.price %>"
        min="0"
        max="100000000000"
        step="1"
        required
      >
      <% if (errors.price) { %>
        <div class="invalid-feedback"><%= errors.price %></div>
      <% } %>
    </div>

    <div class="col-md-6">
      <label class="form-label fw-semibold" for="category">Danh mục</label>
      <select
        class="form-select<%= errors.category ? ' is-invalid' : '' %>"
        id="category"
        name="category"
        required
      >
        <option value="">Chọn danh mục</option>
        <% categories.forEach((category) => { %>
          <option
            value="<%= category._id %>"
            <%= oldInput.category === category._id.toString() ? 'selected' : '' %>
            <%= category.status !== 'active' ? 'disabled' : '' %>
          >
            <%= category.name %><%= category.status !== 'active' ? ' (Không hoạt động)' : '' %>
          </option>
        <% }); %>
      </select>
      <% if (errors.category) { %>
        <div class="invalid-feedback"><%= errors.category %></div>
      <% } %>
    </div>

    <div class="col-md-6">
      <label class="form-label fw-semibold" for="location">Địa điểm</label>
      <input
        class="form-control<%= errors.location ? ' is-invalid' : '' %>"
        id="location"
        name="location"
        type="text"
        value="<%= oldInput.location %>"
        minlength="2"
        maxlength="150"
        required
      >
      <% if (errors.location) { %>
        <div class="invalid-feedback"><%= errors.location %></div>
      <% } %>
    </div>

    <div class="col-md-6">
      <label class="form-label fw-semibold" for="condition">Tình trạng</label>
      <select
        class="form-select<%= errors.condition ? ' is-invalid' : '' %>"
        id="condition"
        name="condition"
        required
      >
        <option value="used"<%= oldInput.condition === 'used' ? ' selected' : '' %>>Đã sử dụng</option>
        <option value="new"<%= oldInput.condition === 'new' ? ' selected' : '' %>>Mới</option>
      </select>
      <% if (errors.condition) { %>
        <div class="invalid-feedback"><%= errors.condition %></div>
      <% } %>
    </div>
  </div>

  <% if (existingImages.length > 0) { %>
    <fieldset class="mt-4">
      <legend class="h5 fw-bold mb-2">Ảnh hiện tại</legend>
      <p class="text-secondary small">
        Bài đăng đang có <%= existingImages.length %> ảnh,
        còn <%= remainingImageSlots %> vị trí trong giới hạn <%= maxImages %> ảnh.
      </p>
      <div class="row g-3">
        <% existingImages.forEach((imagePath, index) => { %>
          <div class="col-6 col-md-4">
            <label class="listing-image-remove-card">
              <img
                class="listing-edit-thumbnail"
                src="<%= imagePath %>"
                alt="Ảnh <%= index + 1 %> của <%= listing.title %>"
                loading="lazy"
              >
              <span class="form-check mt-2">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="removeImages"
                  value="<%= imagePath %>"
                  <%= selectedRemoveImages.includes(imagePath) ? 'checked' : '' %>
                >
                <span class="form-check-label">Xóa ảnh này</span>
              </span>
            </label>
          </div>
        <% }); %>
      </div>
    </fieldset>
  <% } %>

  <div class="mt-4">
    <label class="form-label fw-semibold" for="images">
      <%= existingImages.length > 0 ? 'Thêm ảnh mới' : 'Ảnh sản phẩm' %>
    </label>
    <input
      class="form-control<%= errors.images ? ' is-invalid' : '' %>"
      id="images"
      name="images"
      type="file"
      accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
      multiple
      aria-describedby="imagesHelp"
    >
    <% if (errors.images) { %>
      <div class="invalid-feedback"><%= errors.images %></div>
    <% } %>
    <div class="form-text" id="imagesHelp">
      Ảnh không bắt buộc. Tối đa <%= maxImages %> ảnh cho mỗi bài đăng,
      mỗi ảnh tối đa 5 MB. Chấp nhận JPG, JPEG, PNG và WEBP.
    </div>
  </div>

  <% if (retryImages) { %>
    <div class="alert alert-warning mt-3 mb-0" role="alert">
      Các file vừa chọn không được giữ lại. Vui lòng chọn lại ảnh trước khi gửi form.
    </div>
  <% } %>

  <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
    <button class="btn btn-primary px-4" type="submit" <%= canSubmit ? '' : 'disabled' %>>
      <%= submitLabel %>
    </button>
    <a class="btn btn-outline-secondary px-4" href="<%= cancelUrl %>">Hủy</a>
  </div>
</form>
