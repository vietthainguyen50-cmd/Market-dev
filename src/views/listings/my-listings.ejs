<%- include('../partials/header') %>

<section class="section-space">
  <div class="container">
    <div class="page-heading mb-4">
      <div>
        <h1 class="mb-2">Bài đăng của tôi</h1>
        <p class="text-secondary mb-0">Quản lý bài đang bán, đã bán và đã ẩn.</p>
      </div>
      <a class="btn btn-primary" href="/listings/create">Đăng sản phẩm mới</a>
    </div>

    <% if (successMessage) { %>
      <div class="alert alert-success" role="status"><%= successMessage %></div>
    <% } %>

    <% if (errors.general) { %>
      <div class="alert alert-danger" role="alert"><%= errors.general %></div>
    <% } %>

    <% if (listings.length > 0) { %>
      <div class="row g-4">
        <% listings.forEach((listing) => { %>
          <div class="col-12 col-md-6 col-xl-4">
            <%- include('_card', { listing, showManageActions: true }) %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state" role="status">
        <h2 class="h4">Bạn chưa có bài đăng nào.</h2>
        <p class="text-secondary">Tạo bài đăng đầu tiên để bắt đầu kết nối với người mua.</p>
        <a class="btn btn-primary" href="/listings/create">Đăng sản phẩm</a>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
