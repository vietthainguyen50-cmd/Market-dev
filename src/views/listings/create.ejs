<%- include('../partials/header') %>

<section class="form-page">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-9 col-xl-8">
        <div class="form-panel">
          <header class="form-panel-header">
            <h1 class="h2">Đăng sản phẩm</h1>
            <p class="text-secondary">Chia sẻ thông tin rõ ràng để người mua dễ tìm và liên hệ.</p>
          </header>

          <% if (!canSubmit) { %>
            <div class="alert alert-warning" role="alert">
              Hiện chưa có danh mục hoạt động. Bạn chưa thể tạo bài đăng.
            </div>
          <% } %>

          <%- include('_form', {
            formAction: '/listings',
            submitLabel: 'Đăng sản phẩm',
            cancelUrl: '/listings',
            canSubmit,
            categories,
            errors,
            oldInput
          }) %>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
