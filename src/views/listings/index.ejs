<%- include('../partials/header') %>

<section class="section-space">
  <div class="container">
    <div class="page-heading mb-4">
      <div>
        <h1 class="mb-2">Tìm kiếm sản phẩm</h1>
        <p class="text-secondary mb-0">Tìm món đồ phù hợp từ các bài đăng trong cộng đồng.</p>
      </div>
      <a class="btn btn-primary" href="<%= isAuthenticated ? '/listings/create' : '/login' %>">
        Đăng tin
      </a>
    </div>

    <form class="listing-filter-panel" method="GET" action="/listings" role="search">
      <% if (Object.keys(filterErrors).length > 0) { %>
        <div class="alert alert-danger" role="alert">
          <p class="fw-semibold mb-2">Vui lòng kiểm tra lại bộ lọc:</p>
          <ul class="mb-0">
            <% [...new Set(Object.values(filterErrors))].forEach((message) => { %>
              <li><%= message %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <fieldset class="filter-group">
        <legend class="h5 mb-3">Từ khóa và phân loại</legend>
        <div class="row g-3">
        <div class="col-12 col-lg-6">
          <label class="form-label fw-semibold" for="keyword">Từ khóa</label>
          <input
            class="form-control <%= filterErrors.keyword ? 'is-invalid' : '' %>"
            id="keyword"
            name="keyword"
            type="text"
            maxlength="100"
            value="<%= filters.keyword %>"
            placeholder="Tìm theo tên hoặc mô tả sản phẩm"
            aria-invalid="<%= filterErrors.keyword ? 'true' : 'false' %>"
            aria-describedby="filterKeywordError"
          >
          <div class="invalid-feedback field-feedback-slot" id="filterKeywordError"><%= filterErrors.keyword || '' %></div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
          <label class="form-label fw-semibold" for="category">Danh mục</label>
          <select
            class="form-select <%= filterErrors.category ? 'is-invalid' : '' %>"
            id="category"
            name="category"
            aria-invalid="<%= filterErrors.category ? 'true' : 'false' %>"
            aria-describedby="filterCategoryError"
          >
            <option value="">Tất cả danh mục</option>
            <% categories.forEach((category) => { %>
              <option value="<%= category.slug %>" <%= filters.category === category.slug ? 'selected' : '' %>>
                <%= category.name %>
              </option>
            <% }); %>
          </select>
          <div class="invalid-feedback field-feedback-slot" id="filterCategoryError"><%= filterErrors.category || '' %></div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
          <label class="form-label fw-semibold" for="condition">Tình trạng</label>
          <select
            class="form-select <%= filterErrors.condition ? 'is-invalid' : '' %>"
            id="condition"
            name="condition"
            aria-invalid="<%= filterErrors.condition ? 'true' : 'false' %>"
            aria-describedby="filterConditionError"
          >
            <option value="">Tất cả tình trạng</option>
            <option value="new" <%= filters.condition === 'new' ? 'selected' : '' %>>Mới</option>
            <option value="used" <%= filters.condition === 'used' ? 'selected' : '' %>>Đã sử dụng</option>
          </select>
          <div class="invalid-feedback field-feedback-slot" id="filterConditionError"><%= filterErrors.condition || '' %></div>
        </div>
        </div>
      </fieldset>

      <fieldset class="filter-group">
        <legend class="h5 mb-3">Giá, khu vực và sắp xếp</legend>
        <div class="row g-3">
        <div class="col-12 col-sm-6 col-lg-3">
          <label class="form-label fw-semibold" for="minPrice">Giá tối thiểu</label>
          <input
            class="form-control <%= filterErrors.minPrice || filterErrors.maxPrice ? 'is-invalid' : '' %>"
            id="minPrice"
            name="minPrice"
            type="number"
            min="0"
            max="100000000000"
            step="1"
            value="<%= filters.minPrice === null ? '' : filters.minPrice %>"
            aria-invalid="<%= filterErrors.minPrice || filterErrors.maxPrice ? 'true' : 'false' %>"
            aria-describedby="filterMinPriceError"
          >
          <div class="invalid-feedback field-feedback-slot" id="filterMinPriceError"><%= filterErrors.minPrice || filterErrors.maxPrice || '' %></div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
          <label class="form-label fw-semibold" for="maxPrice">Giá tối đa</label>
          <input
            class="form-control <%= filterErrors.maxPrice ? 'is-invalid' : '' %>"
            id="maxPrice"
            name="maxPrice"
            type="number"
            min="0"
            max="100000000000"
            step="1"
            value="<%= filters.maxPrice === null ? '' : filters.maxPrice %>"
            aria-invalid="<%= filterErrors.maxPrice ? 'true' : 'false' %>"
            aria-describedby="filterMaxPriceError"
          >
          <div class="invalid-feedback field-feedback-slot" id="filterMaxPriceError"><%= filterErrors.maxPrice || '' %></div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
          <label class="form-label fw-semibold" for="location">Địa điểm</label>
          <input
            class="form-control <%= filterErrors.location ? 'is-invalid' : '' %>"
            id="location"
            name="location"
            type="text"
            maxlength="150"
            value="<%= filters.location %>"
            placeholder="Khu vực, tỉnh hoặc thành phố"
            aria-invalid="<%= filterErrors.location ? 'true' : 'false' %>"
            aria-describedby="filterLocationError"
          >
          <div class="invalid-feedback field-feedback-slot" id="filterLocationError"><%= filterErrors.location || '' %></div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
          <label class="form-label fw-semibold" for="status">Trạng thái</label>
          <select
            class="form-select <%= filterErrors.status ? 'is-invalid' : '' %>"
            id="status"
            name="status"
            aria-invalid="<%= filterErrors.status ? 'true' : 'false' %>"
            aria-describedby="filterStatusError"
          >
            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>Tất cả bài đăng</option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Đang bán</option>
            <option value="sold" <%= filters.status === 'sold' ? 'selected' : '' %>>Đã bán</option>
          </select>
          <div class="invalid-feedback field-feedback-slot" id="filterStatusError"><%= filterErrors.status || '' %></div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
          <label class="form-label fw-semibold" for="sort">Sắp xếp</label>
          <select
            class="form-select <%= filterErrors.sort ? 'is-invalid' : '' %>"
            id="sort"
            name="sort"
            aria-invalid="<%= filterErrors.sort ? 'true' : 'false' %>"
            aria-describedby="filterSortError"
          >
            <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Mới nhất</option>
            <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Cũ nhất</option>
            <option value="price-asc" <%= filters.sort === 'price-asc' ? 'selected' : '' %>>Giá tăng dần</option>
            <option value="price-desc" <%= filters.sort === 'price-desc' ? 'selected' : '' %>>Giá giảm dần</option>
          </select>
          <div class="invalid-feedback field-feedback-slot" id="filterSortError"><%= filterErrors.sort || '' %></div>
        </div>
        <div class="col-12 col-lg-6 filter-actions">
          <button class="btn btn-primary flex-grow-1" type="submit">Tìm kiếm</button>
          <a class="btn btn-outline-secondary" href="/listings">Xóa bộ lọc</a>
        </div>
      </div>
      </fieldset>
    </form>

    <% if (Object.keys(filterErrors).length === 0) { %>
      <div class="listing-results-summary d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <p class="fw-semibold mb-0" data-total-items="<%= totalItems %>">
          Tìm thấy <%= totalItems %> sản phẩm
        </p>
        <% if (pagination.totalPages > 1) { %>
          <p class="small text-secondary mb-0">Trang <%= pagination.page %> / <%= pagination.totalPages %></p>
        <% } %>
      </div>
    <% } %>

    <% if (listings.length > 0) { %>
      <div class="row g-4">
        <% listings.forEach((listing) => { %>
          <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <%- include('_card', {
              listing,
              showFavoriteAction: true,
              favoriteReturnTo: currentUrl
            }) %>
          </div>
        <% }); %>
      </div>

      <%- include('_pagination', { pagination }) %>
    <% } else if (Object.keys(filterErrors).length === 0) { %>
      <div class="listing-empty-state" role="status">
        <h2 class="h4 fw-bold">Không tìm thấy sản phẩm phù hợp với bộ lọc hiện tại.</h2>
        <p class="text-secondary">Hãy thử điều chỉnh từ khóa hoặc xóa bộ lọc để xem tất cả bài đăng.</p>
        <a class="btn btn-outline-primary" href="/listings">Xóa bộ lọc</a>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
