<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta
      name="description"
      content="NTT Marketplace - Nền tảng mua bán và đăng tin sản phẩm cũ."
    >
    <title><%= pageTitle %> | <%= siteName %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    >
    <link
      href="https://cdn.jsdelivr.net/npm/@fontsource-variable/geist@5.2.8/index.css"
      rel="stylesheet"
    >
    <link
      href="https://cdn.jsdelivr.net/npm/@fontsource-variable/inter@5.2.8/index.css"
      rel="stylesheet"
    >
    <link rel="stylesheet" href="/css/tokens.css">
    <link rel="stylesheet" href="/css/style.css">
    <% if (typeof pageStyles !== 'undefined' && Array.isArray(pageStyles)) { %>
      <% pageStyles.forEach((stylePath) => { %>
        <link rel="stylesheet" href="<%= stylePath %>">
      <% }); %>
    <% } %>
  </head>
  <body>
    <header class="site-header sticky-top">
      <nav class="navbar navbar-expand-xl site-navbar" aria-label="Điều hướng tài khoản">
        <div class="container site-navbar-inner">
          <a class="navbar-brand site-wordmark" href="/" aria-label="NTT Marketplace — Trang chủ">
            <span class="brand-mark">
  <img src="/images/logo.svg" alt="">
</span>
            <span>NTT Marketplace</span>
          </a>

          <form class="site-global-search" method="GET" action="/listings" role="search">
            <label class="visually-hidden" for="globalKeyword">Tìm sản phẩm</label>
            <input
              class="site-global-search__input"
              id="globalKeyword"
              name="keyword"
              type="search"
              maxlength="100"
              placeholder="Tìm kiếm sản phẩm…"
            >
            <button class="site-global-search__button" type="submit" aria-label="Tìm kiếm">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-4-4"></path>
              </svg>
              <span>Tìm kiếm</span>
            </button>
          </form>

          <button
            class="navbar-toggler site-navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNavigation"
            aria-controls="mainNavigation"
            aria-expanded="false"
            aria-label="Mở điều hướng"
          >
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="mainNavigation">
            <ul class="navbar-nav site-nav-account align-items-lg-center ms-xl-auto">
            <% if (isAuthenticated) { %>
              <% if (currentUser.role === 'admin') { %>
                <li class="nav-item">
                  <a class="nav-link" href="/admin">Quản trị</a>
                </li>
              <% } %>
              <li class="nav-item">
                <a class="nav-link" href="/my-listings">Tin của tôi</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/favorites">Tin đã lưu</a>
              </li>
              <li class="nav-item">
                <a
                  class="nav-link nav-messages-link"
                  href="/messages"
                  aria-label="Tin nhắn<%= unreadMessageCount > 0 ? `, ${unreadMessageCount > 99 ? 'trên 99' : unreadMessageCount} tin chưa đọc` : '' %>"
                >
                  <span>Tin nhắn</span>
                  <% if (unreadMessageCount > 0) { %>
                    <span
                      class="nav-unread-badge"
                      aria-label="<%= unreadMessageCount > 99 ? 'Trên 99 tin chưa đọc' : `${unreadMessageCount} tin chưa đọc` %>"
                    >
                      <%= unreadMessageCount > 99 ? '99+' : unreadMessageCount %>
                    </span>
                  <% } %>
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link nav-profile-link" href="/profile">
                  <img
                    class="header-avatar"
                    src="<%= currentUser.avatarUrl %>"
                    alt="Ảnh đại diện của <%= currentUser.name %>"
                    width="32"
                    height="32"
                  >
                  <span class="nav-profile-copy">
                    <span>Hồ sơ</span>
                    <span class="nav-user-name"><%= currentUser.name %></span>
                  </span>
                </a>
              </li>
              <li class="nav-item">
                <form method="POST" action="/logout">
                  <%- include('csrf') %>
                  <button class="btn btn-outline-secondary site-nav-button" type="submit">
                    Đăng xuất
                  </button>
                </form>
              </li>
            <% } else { %>
              <li class="nav-item"><a class="nav-link" href="/login">Đăng nhập</a></li>
              <li class="nav-item">
                <a class="btn btn-outline-secondary site-nav-button" href="/register">Đăng ký</a>
              </li>
            <% } %>
            <li class="nav-item">
              <a class="btn btn-primary site-nav-button" href="<%= isAuthenticated ? '/listings/create' : '/login' %>">
                Đăng tin
              </a>
            </li>
            </ul>
          </div>
        </div>
      </nav>

      <nav class="site-category-rail" aria-label="Khám phá Marketplace">
        <div class="container site-category-rail__inner">
          <a href="/">Trang chủ</a>
          <a href="/categories">Danh mục</a>
          <a href="/listings">Sản phẩm mới</a>
          <a class="site-category-rail__post" href="<%= isAuthenticated ? '/listings/create' : '/login' %>">
            Đăng tin miễn phí
          </a>
        </div>
      </nav>
    </header>
    <main>
