<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta
      name="description"
      content="NTT Marketplace - Nền tảng mua bán và đăng tin sản phẩm cũ."
    >
    <title><%= pageTitle %> | <%= siteName %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    >
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top site-navbar" aria-label="Điều hướng chính">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/">
          <span class="brand-mark" aria-hidden="true">N</span>
          NTT Marketplace
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNavigation"
          aria-controls="mainNavigation"
          aria-expanded="false"
          aria-label="Mở điều hướng"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavigation">
          <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
            <li class="nav-item"><a class="nav-link" href="/#categories">Danh mục</a></li>
            <li class="nav-item"><a class="nav-link" href="/#products">Sản phẩm</a></li>
            <% if (isAuthenticated) { %>
              <li class="nav-item">
                <span class="navbar-text text-white">Xin chào, <%= currentUser.name %></span>
              </li>
              <li class="nav-item">
                <form method="POST" action="/logout">
                  <button class="btn btn-outline-light ms-lg-2 px-3" type="submit">
                    Đăng xuất
                  </button>
                </form>
              </li>
            <% } else { %>
              <li class="nav-item"><a class="nav-link" href="/login">Đăng nhập</a></li>
              <li class="nav-item"><a class="nav-link" href="/register">Đăng ký</a></li>
            <% } %>
            <li class="nav-item">
              <a class="btn btn-warning ms-lg-2 px-3" href="/#post-ad">Đăng tin</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>
    <main>
