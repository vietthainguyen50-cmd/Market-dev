<%- include('../../partials/header') %>

<section class="section-space">
  <div class="container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
      <div>
        <p class="section-kicker">Khu vực quản trị</p>
        <h1 class="fw-bold mb-0">Quản lý danh mục</h1>
      </div>
      <a class="btn btn-primary" href="/admin/categories/create">Thêm danh mục</a>
    </div>

    <% if (successMessage) { %>
      <div class="alert alert-success" role="status"><%= successMessage %></div>
    <% } %>

    <% if (errors.general) { %>
      <div class="alert alert-danger" role="alert"><%= errors.general %></div>
    <% } %>

    <% if (categories.length > 0) { %>
      <div class="table-responsive bg-white border rounded-4 shadow-sm">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col">Tên</th>
              <th scope="col">Slug</th>
              <th scope="col">Mô tả</th>
              <th scope="col">Trạng thái</th>
              <th scope="col">Ngày tạo</th>
              <th scope="col" class="text-end">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <% categories.forEach((category) => { %>
              <tr>
                <td class="fw-semibold"><%= category.name %></td>
                <td><code><%= category.slug %></code></td>
                <td class="admin-description"><%= category.descriptionPreview || '—' %></td>
                <td>
                  <% if (category.status === 'active') { %>
                    <span class="badge text-bg-success">Đang hoạt động</span>
                  <% } else { %>
                    <span class="badge text-bg-secondary">Đang ẩn</span>
                  <% } %>
                </td>
                <td><%= category.formattedCreatedAt %></td>
                <td>
                  <div class="d-flex justify-content-end flex-wrap gap-2">
                    <a
                      class="btn btn-sm btn-outline-primary"
                      href="/admin/categories/<%= category._id %>/edit"
                    >
                      Chỉnh sửa
                    </a>
                    <form
                      method="POST"
                      action="/admin/categories/<%= category._id %>/status?_method=PATCH"
                    >
                      <input
                        type="hidden"
                        name="status"
                        value="<%= category.status === 'active' ? 'inactive' : 'active' %>"
                      >
                      <button class="btn btn-sm btn-outline-secondary" type="submit">
                        <%= category.status === 'active' ? 'Ẩn danh mục' : 'Kích hoạt' %>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="alert alert-info" role="status">
        Chưa có danh mục nào. Hãy tạo danh mục đầu tiên.
      </div>
    <% } %>
  </div>
</section>

<%- include('../../partials/footer') %>
