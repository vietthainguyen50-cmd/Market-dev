<form class="admin-category-form" action="<%= formAction %>" method="POST">
  <div class="mb-3">
    <label class="form-label fw-semibold" for="name">Tên danh mục</label>
    <input
      class="form-control<%= errors.name ? ' is-invalid' : '' %>"
      id="name"
      name="name"
      type="text"
      value="<%= oldInput.name %>"
      minlength="2"
      maxlength="100"
      aria-invalid="<%= errors.name ? 'true' : 'false' %>"
      aria-describedby="categoryNameError categoryNameHelp"
      required
    >
    <div class="invalid-feedback field-feedback-slot" id="categoryNameError"><%= errors.name || '' %></div>
    <div class="form-text" id="categoryNameHelp">Slug sẽ được hệ thống tự động tạo từ tên.</div>
  </div>

  <div class="mb-3">
    <label class="form-label fw-semibold" for="description">Mô tả</label>
    <textarea
      class="form-control<%= errors.description ? ' is-invalid' : '' %>"
      id="description"
      name="description"
      rows="5"
      maxlength="500"
      aria-invalid="<%= errors.description ? 'true' : 'false' %>"
      aria-describedby="categoryDescriptionError"
    ><%= oldInput.description %></textarea>
    <div class="invalid-feedback field-feedback-slot" id="categoryDescriptionError"><%= errors.description || '' %></div>
  </div>

  <div class="mb-3">
    <label class="form-label fw-semibold" for="image">URL hoặc đường dẫn ảnh tĩnh</label>
    <input
      class="form-control<%= errors.image ? ' is-invalid' : '' %>"
      id="image"
      name="image"
      type="text"
      value="<%= oldInput.image %>"
      maxlength="2048"
      placeholder="https://example.com/image.jpg hoặc /images/category.jpg"
      aria-invalid="<%= errors.image ? 'true' : 'false' %>"
      aria-describedby="categoryImageError"
    >
    <div class="invalid-feedback field-feedback-slot" id="categoryImageError"><%= errors.image || '' %></div>
  </div>

  <div class="mb-4">
    <label class="form-label fw-semibold" for="status">Trạng thái</label>
    <select
      class="form-select<%= errors.status ? ' is-invalid' : '' %>"
      id="status"
      name="status"
      aria-invalid="<%= errors.status ? 'true' : 'false' %>"
      aria-describedby="categoryStatusError"
      required
    >
      <option value="active"<%= oldInput.status === 'active' ? ' selected' : '' %>>Hoạt động</option>
      <option value="inactive"<%= oldInput.status === 'inactive' ? ' selected' : '' %>>Ẩn</option>
    </select>
    <div class="invalid-feedback field-feedback-slot" id="categoryStatusError"><%= errors.status || '' %></div>
  </div>

  <div class="form-actions">
    <button class="btn btn-primary px-4" type="submit"><%= submitLabel %></button>
    <a class="btn btn-outline-secondary px-4" href="/admin/categories">Hủy</a>
  </div>
</form>
