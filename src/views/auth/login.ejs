<%- include('../partials/header') %>

<section class="auth-section py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-md-9 col-lg-6 col-xl-5">
        <div class="auth-panel bg-white border shadow-sm p-4 p-md-5">
          <h1 class="h2 fw-bold mb-2">Đăng nhập</h1>
          <p class="text-secondary mb-4">
            Đăng nhập để tiếp tục sử dụng NTT Marketplace.
          </p>

          <% if (successMessage) { %>
            <div class="alert alert-success" role="status"><%= successMessage %></div>
          <% } %>

          <% if (infoMessage) { %>
            <div class="alert alert-info" role="status"><%= infoMessage %></div>
          <% } %>

          <% if (errors.general) { %>
            <div class="alert alert-danger" role="alert"><%= errors.general %></div>
          <% } %>

          <form action="/login" method="post">
            <div class="mb-3">
              <label class="form-label fw-semibold" for="email">Email</label>
              <input
                class="form-control<%= errors.email ? ' is-invalid' : '' %>"
                id="email"
                name="email"
                type="email"
                value="<%= oldInput.email || '' %>"
                autocomplete="email"
                maxlength="254"
                required
              >
              <% if (errors.email) { %>
                <div class="invalid-feedback"><%= errors.email %></div>
              <% } %>
            </div>

            <div class="mb-4">
              <label class="form-label fw-semibold" for="password">Mật khẩu</label>
              <input
                class="form-control<%= errors.password ? ' is-invalid' : '' %>"
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                maxlength="72"
                required
              >
              <% if (errors.password) { %>
                <div class="invalid-feedback"><%= errors.password %></div>
              <% } %>
            </div>

            <button class="btn btn-primary w-100 py-2 fw-semibold" type="submit">
              Đăng nhập
            </button>
          </form>

          <p class="text-center text-secondary mt-4 mb-2">
            Chưa có tài khoản? <a href="/register">Đăng ký ngay</a>
          </p>
          <div class="text-center">
            <a class="link-secondary" href="/">Quay về trang chủ</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
