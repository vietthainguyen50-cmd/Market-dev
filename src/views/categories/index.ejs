<%- include('../partials/header') %>

<section class="section-space">
  <div class="container">
    <div class="section-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3">
      <div>
        <p class="section-kicker">Khám phá marketplace</p>
        <h1 class="fw-bold mb-2">Danh mục sản phẩm</h1>
        <p class="text-secondary mb-0">Chọn danh mục phù hợp để khám phá các tin đăng.</p>
      </div>
      <a class="btn btn-outline-primary" href="/">Quay về trang chủ</a>
    </div>

    <% if (categories.length > 0) { %>
      <div class="row g-4 mt-3">
        <% categories.forEach((category) => { %>
          <div class="col-sm-6 col-lg-4 col-xl-3">
            <article class="category-card h-100 d-flex flex-column">
              <div class="category-media mb-4">
                <% if (category.image) { %>
                  <img
                    class="category-image"
                    src="<%= category.image %>"
                    alt="Ảnh danh mục <%= category.name %>"
                  >
                <% } else { %>
                  <div class="category-placeholder" aria-hidden="true">
                    <span><%= category.name.charAt(0).toUpperCase() %></span>
                  </div>
                <% } %>
              </div>
              <h2 class="h5 fw-bold"><%= category.name %></h2>
              <p class="text-secondary flex-grow-1">
                <%= category.description || 'Khám phá các sản phẩm trong danh mục này.' %>
              </p>
              <a class="btn btn-primary align-self-start" href="/categories/<%= category.slug %>">
                Xem sản phẩm
              </a>
            </article>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="alert alert-info mt-4" role="status">
        Hiện chưa có danh mục đang hoạt động.
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
